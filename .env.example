# Copy this file to .env. Fixed public demo values are ready to use. Only
# console/provider-created IDs and secrets remain blank; never invent those.

# AuthSec authorization server
AUTHSEC_ISSUER=https://prod.api.authsec.ai
AUTHSEC_AUTHORIZATION_SERVER=https://prod.api.authsec.ai
AUTHSEC_JWKS_URL=https://prod.api.authsec.ai/oauth/jwks
AUTHSEC_INTROSPECTION_URL=https://prod.api.authsec.ai/oauth/introspect

# AuthSec product/admin API. This is deliberately separate from the OAuth
# issuer: app.authsec.ai serves the login/console UI, while prod.api.authsec.ai
# serves OAuth and workspace administration APIs used by recovery.
AUTHSEC_ADMIN_API_URL=https://prod.api.authsec.ai

# Protected Application / Resource Server
AUTHSEC_RESOURCE_URI=https://mcp-demo.mcpauthz.com/mcp
AUTHSEC_RESOURCE_NAME="GitHub MCP Demo"
AUTHSEC_RESOURCE_SERVER_ID=
AUTHSEC_INTROSPECTION_CLIENT_ID=
AUTHSEC_INTROSPECTION_CLIENT_SECRET=
AUTHSEC_POLICY_MODE=remote_required
AUTHSEC_VALIDATION_MODE=jwt_and_introspect
AUTHSEC_PUBLISH_MANIFEST=true

# Workspace guard used only by optional bootstrap/reset automation.
# AUTHSEC_ADMIN_TOKEN is deliberately not persisted here. The MCP server does
# not need it; export a short-lived token only if you explicitly run automation.
AUTHSEC_DEMO_WORKSPACE_ID=
AUTHSEC_CONSOLE_URL=https://app.authsec.ai

# Personal GitHub App: owned by Aditya250401 and installed only on the three
# personal demo repositories. Permissions: Contents read + Issues read/write.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=

# M2M machine identity. `pnpm m2m:setup` generates the ignored local private
# key and records its path + kid in .state/bootstrap.json. After the AuthSec
# machine-credential wizard, record its client ID with
# `uv run setup-m2m --client-id <ID>`. These env fields are optional overrides.
AUTHSEC_M2M_CLIENT_ID=
AUTHSEC_M2M_PRIVATE_KEY_PATH=
AUTHSEC_M2M_KEY_ID=

# SPIFFE workload identity
DEMO_ENABLE_SPIRE=false
SPIRE_TRUST_DOMAIN=authsec.demo
SPIRE_OIDC_DISCOVERY_URL=https://spire-demo.mcpauthz.com
SPIRE_AGENT_SOCKET_PATH=/run/spire/sockets/agent.sock
SPIFFE_CLIENT_ID=
SPIFFE_ID=spiffe://authsec.demo/workload/release-reporter

# XAA agent. This confidential secret is used for native token exchange; the
# browser login leg remains public/PKCE.
AUTHSEC_AGENT_CLIENT_ID=
AUTHSEC_AGENT_CLIENT_SECRET=
AUTHSEC_AGENT_LOGIN_PORT=8126

# Agent model. gpt-5.4-mini supports tool calling at a much lower cost than the
# frontier models; change this explicitly if the account does not expose it.
DEMO_LLM_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=

# Local process/tunnel settings
DEMO_HOST=0.0.0.0
DEMO_PORT=8091
DEMO_RUN_ID=live-demo
MCP_TUNNEL_CONFIG=/Users/pc/.cloudflared/authsec-mcp-demo.yml
SPIRE_TUNNEL_CONFIG=/Users/pc/.cloudflared/authsec-spire-demo.yml

# Tracing / logging
#   DEMO_LOG_LEVEL   INFO (default) or DEBUG. DEBUG surfaces SDK internals.
#   DEMO_LOG_FILE    optional path; also writes a plain-text trace log there.
#   DEMO_TRACE_HTTP  "full" adds httpcore wire tracing (CAN log bearer headers).
#   DEMO_LOG_RAW_TOKENS  "true" logs raw bearer tokens at DEBUG (local debug only).
DEMO_LOG_LEVEL=INFO
DEMO_LOG_FILE=
DEMO_TRACE_HTTP=false
DEMO_LOG_RAW_TOKENS=false
