{
  "name": "authsec-github-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preflight": "uv run preflight",
    "m2m:setup": "uv run setup-m2m",
    "server": "uv run authsec-demo-server",
    "bootstrap": "uv run bootstrap",
    "recover": "uv run recover",
    "smoke": "uv run smoke",
    "reset": "uv run reset",
    "spire:up": "bash scripts/spire-up.sh",
    "spire:down": "docker compose -f spire/docker-compose.spire.yml down",
    "agent:spiffe": "bash scripts/run-spiffe-agent.sh run release-reporter",
    "agent:spiffe:proof": "bash scripts/run-spiffe-agent.sh proof release-reporter",
    "share:stop": "bash scripts/stop-share.sh",
    "share": "bash scripts/share.sh"
  },
  "packageManager": "pnpm@9.1.2"
}
